#lang racket/base
(require amb amb/merge)
(define N 200000)
(define (measure name thk)
  (collect-garbage)
  (define m0 (current-memory-use 'cumulative))
  (define t0 (current-process-milliseconds))
  (for ([_ (in-range N)]) (thk))
  (define t (- (current-process-milliseconds) t0))
  (printf "~a~a ~a B/iter  ~a ns/iter\n" name (make-string (max 0 (- 34 (string-length name))) #\space)
          (quotient (- (current-memory-use 'cumulative) m0) N) (quotient (* t 1000000) N)))
(define (count thk) (for/fold ([n 0]) ([_ (in-amb*/do thk)]) (add1 n)))
(measure "empty search (1 answer)" (λ () (count (λ () 1))))
(measure "+ amb-pause" (λ () (count (λ () (amb-pause) 1))))
(measure "+ 10 amb-pause" (λ () (count (λ () (for ([_ 10]) (amb-pause)) 1))))
(measure "+ amb-fail" (λ () (count (λ () (amb-fail)))))
(measure "+ (amb)" (λ () (count (λ () (amb)))))
(measure "+ (amb 1 2)" (λ () (count (λ () (amb 1 2)))))
(measure "+ (amb 1 2) interleave" (λ () (parameterize ([current-amb-merger amb-interleave]) (count (λ () (amb 1 2))))))
(measure "+ sequence->amb list 2" (λ () (count (λ () (sequence->amb '(1 2))))))
(measure "+ parameterize" (λ () (count (λ () (parameterize ([current-amb-merger amb-append]) 1)))))
(measure "+ amb-local* 1 answer" (λ () (count (λ () (amb-local* (λ () 1))))))
(measure "+ 10 nested amb-local*" (λ () (count (λ () (let loop ([n 10]) (if (zero? n) 1 (amb-local* (λ () (loop (sub1 n))))))))))
(measure "+ 10 nested amb-local*, 2 ans" (λ () (count (λ () (let loop ([n 10]) (if (zero? n) (amb 1 2) (amb-local* (λ () (loop (sub1 n))))))))))
(measure "deep stack 50 + amb-pause" (λ () (count (λ () (let loop ([n 50]) (if (zero? n) (begin (amb-pause) 1) (add1 (loop (sub1 n)))))))))
(measure "hasheq set x1" (λ () (hash-set #hasheq() (gensym) 1)))
