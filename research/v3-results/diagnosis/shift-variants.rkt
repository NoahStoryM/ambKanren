#lang racket/base
(require racket/control)
(define tag (make-continuation-prompt-tag 'amb))
(printf "reset-at + shift0-at: prompt in body? ~a\n" (reset-at tag (shift0-at tag k (continuation-prompt-available? tag))))
(printf "reset0-at + shift0-at: prompt in body? ~a\n" (reset0-at tag (shift0-at tag k (continuation-prompt-available? tag))))
(printf "reset-at + shift-at: prompt in body? ~a\n" (reset-at tag (shift-at tag k (continuation-prompt-available? tag))))
(printf "plain abort, default handler: ~a\n"
  (call-with-continuation-prompt (λ () (abort-current-continuation tag (λ () (continuation-prompt-available? tag)))) tag))
;; cost
(define N 1000000)
(define-syntax-rule (bench name e)
  (begin (collect-garbage)
    (let ([m0 (current-memory-use 'cumulative)] [t0 (current-process-milliseconds)])
      (for ([_ (in-range N)]) e)
      (printf "~a~a ~a ns  ~a B\n" name (make-string (- 30 (string-length name)) #\space)
              (quotient (* 1000000 (- (current-process-milliseconds) t0)) N)
              (quotient (- (current-memory-use 'cumulative) m0) N)))))
(define (deep n thk) (if (zero? n) (thk) (add1 (deep (sub1 n) thk))))
(bench "shift-at, discard k" (reset-at tag (shift-at tag k 1)))
(bench "shift0-at, discard k" (reset-at tag (shift0-at tag k 1)))
(bench "control0-at, discard k" (reset-at tag (control0-at tag k 1)))
(bench "plain abort (no capture)" (reset-at tag (abort-current-continuation tag (λ () 1))))
(bench "shift-at, resume k" (reset-at tag (+ 1 (shift-at tag k (k 1)))))
(bench "shift0-at, resume k" (reset-at tag (+ 1 (shift0-at tag k (k 1)))))
(bench "control0-at, resume k" (reset-at tag (+ 1 (control0-at tag k (reset-at tag (k 1))))))
(bench "shift-at, depth 20, resume" (reset-at tag (deep 20 (λ () (shift-at tag k (k 1))))))
(bench "shift0-at, depth 20, resume" (reset-at tag (deep 20 (λ () (shift0-at tag k (k 1))))))
