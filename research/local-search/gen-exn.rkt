#lang racket/base
;; Derive trs2-exn.rkt from trs2-local.rkt (UNFUSED, so every
;; suspension really goes through the effects): the pause is Racket's
;; own exception mechanism instead of a private prompt tag.
;;   Stream effect : amb            (choice, failure)
;;   Maybe effect  : raise          (abort without a value)
;;   handler       : with-handlers, installed INSIDE every in-amb/do
;; Needs only amb master.
;; Usage: racket gen-exn.rkt trs2-local.rkt trs2-exn.rkt
(require racket/file racket/string)
(define-values (src dst) (values (vector-ref (current-command-line-arguments) 0)
                                 (vector-ref (current-command-line-arguments) 1)))
(define (rep s from to)
  (define r (string-replace s from to #:all? #f))
  (when (equal? r s) (error 'gen-exn "pattern not found: ~a" from))
  r)
(define out
  (for/fold ([s (file->string src)])
            ([p (list
   (cons ";; RESEARCH PROTOTYPE (ambKanren issue #14)."
         ";; EXCEPTION VARIANT (generated by gen-exn.rkt from trs2-local.rkt):\n;; amb for choice, Racket's raise / with-handlers for the pause, the\n;; handler installed inside every local search.  amb master only.\n;;\n;; RESEARCH PROTOTYPE (ambKanren issue #14).")
   (cons "(: pause-tag (Prompt-Tagof (U Substitution Symbol) (→ Symbol)))\n(define pause-tag (make-continuation-prompt-tag 'kanren-pause))\n(define PAUSE : Symbol (string->uninterned-symbol \"PAUSE\"))\n"
         ";; The raised value is PAUSE itself: an uninterned symbol, so a flat\n;; value Typed Racket lets us raise, and one no program can forge.\n(define PAUSE : Symbol (string->uninterned-symbol \"PAUSE\"))\n(define (pause? [v : Any]) (eq? v PAUSE))\n")
   (cons ";; The suspension of an immature stream, made observable: keep the rest\n;; of the computation as the second alternative of a choice point, and\n;; report PAUSE as a leaf of the nearest local search."
         ";; The suspension of an immature stream, made observable: keep the rest\n;; of the computation as the second alternative of a choice point, and\n;; RAISE in the first; the handler of the nearest local search turns it\n;; into a PAUSE leaf.")
   (cons "  (when (amb #t #f)\n    (abort-current-continuation pause-tag)))"
         "  (when (amb #t #f)\n    (raise PAUSE)))")
   (cons "      (call-with-continuation-prompt\n       (λ () : (U Substitution Symbol) (g s))\n       pause-tag\n       (λ () PAUSE)))))"
         "      (with-handlers ([pause? (λ (_) PAUSE)])\n        (ann (g s) (U Substitution Symbol))))))"))])
    (rep s (car p) (cdr p))))
(display-to-file out dst #:exists 'replace)
