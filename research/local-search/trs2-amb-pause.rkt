#lang typed/racket/base

;; AMB-PAUSE VARIANT: as trs2-local-fused.rkt, but the suspension is amb's
;; own `pause` observed with `in-amb/pause` (no extra prompt tag), so a
;; pause can never escape the search that contains it.
;;
;; FUSED VARIANT of trs2-local.rkt (generated by gen-fused.rkt):
;; reify-goal (lift f) = f, so amb runs only direct-style leaves.
;;
;; RESEARCH PROTOTYPE (ambKanren issue #14).  TRS2 miniKanren that keeps
;; Goal : Substitution -> Substitution, but whose search combinators are
;; the stream combinators of trs2-impl.scm applied LOCALLY:
;;
;;   reify-goal : Goal Substitution -> Inf   a nested in-amb/do search
;;                of (g s) in which a suspension is an observable PAUSE
;;                leaf (one extra prompt tag);
;;   reflect    : Inf -> Substitution        answers become amb choice
;;                points, suspensions are re-emitted as pauses.
;;
;; disj2 / conj2 / ifte / once are literally append-inf / append-map-inf
;; / ifte / once of the second edition, lifted by
;;   (lift f) = (λ (s) (reflect (f s))).
;; No change to amb is required.  Everything else is unchanged from
;; miniKanren/amb/trs2/main.rkt, whose header follows.
;;
;; ambKanren with the language of The Reasoned Schemer, second edition.
;;
;; The interface and the definitions of walk, unify, ifte, once, and
;; reification follow the official code of the second edition
;; (https://github.com/TheReasonedSchemer2ndEd/CodeFromTheReasonedSchemer2ndEd,
;; trs2-impl.scm), Copyright (c) 2018 Daniel P. Friedman, William E.
;; Byrd, Oleg Kiselyov, and Jason Hemann, MIT License; see NOTICE.
;;
;; Goals are Substitution -> Substitution, and backtracking is done by
;; amb instead of streams.  The suspension that the second edition
;; inserts in every relation (an immature stream) is a choice point
;; whose continuation is sent to the back of amb's frontier.

(require (for-syntax racket/base syntax/parse)
         typed/amb)

(provide (all-defined-out))


;;; Terms and substitutions

(define-type Term
  (∪ Boolean Number Char Bytes String Keyword Null Symbol
     Var (Pair Term Term)))
(define-type Substitution (Immutable-HashTable Var Term))
(define-type Goal (→ Substitution Substitution))

(struct var ([name : Symbol])
  #:type-name Var
  #:transparent)

(: empty-s Substitution)
(define empty-s #hasheq())

(: walk (→ Term Substitution Term))
(define (walk v s)
  (if (and (var? v) (hash-has-key? s v))
      (walk (hash-ref s v) s)
      v))

(: occurs? (→ Var Term Substitution Boolean))
(define (occurs? x v s)
  (let ([v (walk v s)])
    (cond
      [(var? v) (eq? v x)]
      [(pair? v) (or (occurs? x (car v) s) (occurs? x (cdr v) s))]
      [else #f])))

;; Fails (with amb) instead of returning #f.
(: ext-s (→ Var Term Substitution Substitution))
(define (ext-s x v s)
  (if (occurs? x v s) (amb) (hash-set s x v)))

(: unify (→ Term Term Substitution Substitution))
(define (unify u v s)
  (let ([u (walk u s)] [v (walk v s)])
    (cond
      [(eq? u v) s]
      [(var? u) (ext-s u v s)]
      [(var? v) (ext-s v u s)]
      [(and (pair? u) (pair? v))
       (unify (cdr u) (cdr v) (unify (car u) (car v) s))]
      [(equal? u v) s]
      [else (amb)])))


;;; Goals

(: == (→ Term Term Goal))
(define ((== u v) s) (unify u v s))

(: succeed Goal)
(define (succeed s) s)

(: fail Goal)
(define (fail s) (amb))


;;; Local search protocol

;; A TRS2 stream; built lazily from a local search, consumed once.
(define-type Inf (Rec I (U Null (Pairof Substitution I) (→ I))))


;; The suspension of an immature stream, made observable: keep the rest
;; of the computation as the second alternative of a choice point, and
;; report PAUSE as a leaf of the nearest local search.  With amb's
;; default strategy (depth-first, unfair; fixed in run-goal) that choice
;; point is resumed at the next step of the same local search.
(: suspend (→ Void))
(define (suspend) (pause))

;; reify: run (g s) as a local search and present it as a TRS2 stream.
;; The mature prefix is computed eagerly and a PAUSE becomes a thunk,
;; which is the shape (g s) has in trs2-impl.scm.
;; Fusion: a lifted goal is not reflected and re-reified.
(: lifted (HashTable Goal (→ Substitution Inf)))
(define lifted (make-weak-hasheq))

(: reify-goal (→ Goal Substitution Inf))
(define (reify-goal g s)
  (define f (hash-ref lifted g #f))
  (if f (f s) (reify-goal/amb g s)))

(: reify-goal/amb (→ Goal Substitution Inf))
(define (reify-goal/amb g s)
  (define-values (more? get)
    (sequence-generate
     (in-amb/pause (g s))))
  (let loop : Inf ()
    (if (more?)
        (let ([v (get)])
          (if (symbol? v) (λ () (loop)) (cons v (loop))))
        '())))

;; Two-way choice point; its `info` names the combinator.
(: choose2 (→ Substitution (→ Substitution) Substitution))
(define (choose2 a thk)
  (define n 0)
  ((inst make-amb Substitution)
   (λ () (< n 2))
   (λ () (set! n (add1 n)) (if (= n 1) a (thk)))
   'reflect))

;; reflect: back to direct style.
(: reflect (→ Inf Substitution))
(define (reflect s-inf)
  (cond
    [(null? s-inf) (amb)]
    [(pair? s-inf) (choose2 (car s-inf) (λ () (reflect (cdr s-inf))))]
    [else (suspend) (reflect (s-inf))]))

(: lift (→ (→ Substitution Inf) Goal))
(define (lift f)
  (define g : Goal (λ (s) (reflect (f s))))
  (hash-set! lifted g f)
  g)

(: append-inf (→ Inf Inf Inf))
(define (append-inf s-inf t-inf)
  (cond
    [(null? s-inf) t-inf]
    [(pair? s-inf) (cons (car s-inf) (append-inf (cdr s-inf) t-inf))]
    [else (λ () (append-inf t-inf (s-inf)))]))

(: append-map-inf (→ (→ Substitution Inf) Inf Inf))
(define (append-map-inf g s-inf)
  (cond
    [(null? s-inf) '()]
    [(pair? s-inf) (append-inf (g (car s-inf)) (append-map-inf g (cdr s-inf)))]
    [else (λ () (append-map-inf g (s-inf)))]))

(: take-inf (→ (Option Natural) Inf (Listof Substitution)))
(define (take-inf n s-inf)
  (cond
    [(and n (zero? n)) '()]
    [(null? s-inf) '()]
    [(pair? s-inf) (cons (car s-inf) (take-inf (and n (sub1 n)) (cdr s-inf)))]
    [else (take-inf n (s-inf))]))

(: disj2 (→ Goal Goal Goal))
(define (disj2 g1 g2)
  (lift (λ (s) (append-inf (reify-goal g1 s) (reify-goal g2 s)))))

(: conj2 (→ Goal Goal Goal))
(define (conj2 g1 g2)
  (lift (λ (s) (append-map-inf (λ ([s : Substitution]) (reify-goal g2 s))
                               (reify-goal g1 s)))))

(: call/fresh (→ Symbol (→ Var Goal) Goal))
(define (call/fresh name f) (f (var name)))

(: ifte (→ Goal Goal Goal Goal))
(define (ifte g1 g2 g3)
  (lift
   (λ (s)
     (let loop : Inf ([s-inf (reify-goal g1 s)])
       (cond
         [(null? s-inf) (reify-goal g3 s)]
         [(pair? s-inf)
          (append-map-inf (λ ([s : Substitution]) (reify-goal g2 s)) s-inf)]
         [else (λ () (loop (s-inf)))])))))

(: once (→ Goal Goal))
(define (once g)
  (lift
   (λ (s)
     (let loop : Inf ([s-inf (reify-goal g s)])
       (cond
         [(null? s-inf) '()]
         [(pair? s-inf) (list (car s-inf))]
         [else (λ () (loop (s-inf)))])))))

;;; Reification

(: walk* (→ Term Substitution Term))
(define (walk* v s)
  (let ([v (walk v s)])
    (cond
      [(var? v) v]
      [(pair? v) (cons (walk* (car v) s) (walk* (cdr v) s))]
      [else v])))

(: reify-name (→ Index Symbol))
(define (reify-name n)
  (string->symbol (format "_~a" n)))

(: reify-s (→ Term Substitution Substitution))
(define (reify-s v r)
  (let ([v (walk v r)])
    (cond
      [(var? v) (hash-set r v (reify-name (hash-count r)))]
      [(pair? v) (reify-s (cdr v) (reify-s (car v) r))]
      [else r])))

(: reify (→ Term (→ Substitution Term)))
(define ((reify v) s)
  (let* ([v (walk* v s)]
         [r (reify-s v empty-s)])
    (walk* v r)))

(: run-goal (→ (Option Natural) Goal (Listof Substitution)))
(define (run-goal n g)
  (parameterize ([current-amb-depth-first? #t] [current-amb-fair? #f])
    (take-inf n (reify-goal g empty-s))))

;;; Syntax

(define-syntax disj
  (syntax-rules ()
    [(_) fail]
    [(_ g) g]
    [(_ g0 g ...) (disj2 g0 (disj g ...))]))

(define-syntax conj
  (syntax-rules ()
    [(_) succeed]
    [(_ g) g]
    [(_ g0 g ...) (conj2 g0 (conj g ...))]))

(define-syntax (defrel stx)
  (syntax-parse stx
    #:datum-literals (:)
    [(_ (name:id arg ...) g ...)
     #:with (param ...)
     (for/list ([arg (in-list (syntax->list #'(arg ...)))])
       (syntax-parse arg
         #:datum-literals (:)
         [x:id #'[x : Term]]
         [[x:id : t] arg]))
     #'(define (name param ...) : Goal
         (lift (λ (s) (λ () (reify-goal (conj g ...) s)))))]))

(define-syntax run
  (syntax-rules ()
    [(_ n (x0 x ...) g ...)
     (run n q (fresh (x0 x ...)
                (== (list x0 x ...) q)
                g ...))]
    [(_ n q g ...)
     (let ([q (var 'q)])
       (map (reify q) (run-goal n (conj g ...))))]))

(define-syntax-rule (run* q g ...) (run #f q g ...))

(define-syntax fresh
  (syntax-rules ()
    [(_ () g ...) (conj g ...)]
    [(_ (x0 x ...) g ...)
     (call/fresh 'x0
                 (λ ([x0 : Var])
                   (fresh (x ...) g ...)))]))

(define-syntax-rule (conde [g ...] ...)
  (disj (conj g ...) ...))

(define-syntax conda
  (syntax-rules ()
    [(_ [g0 g ...]) (conj g0 g ...)]
    [(_ [g0 g ...] ln ...)
     (ifte g0 (conj g ...) (conda ln ...))]))

(define-syntax-rule (condu [g0 g ...] ...)
  (conda [(once g0) g ...] ...))

(define-syntax-rule (project (x ...) g ...)
  (λ ([s : Substitution])
    (let ([x (walk* x s)] ...)
      ((conj g ...) s))))
