#lang racket/base
;; Derive trs2-amb-plain.rkt from trs2-local-fused.rkt: no extra prompt
;; tag and no amb extension (amb master).  Combinators stay TRS2 streams
;; (fused); amb runs only direct-style goals, which are atomic with
;; respect to suspensions; `reflect` forces suspensions instead of
;; re-emitting them.
;; Usage: racket gen-amb-plain.rkt trs2-local-fused.rkt trs2-amb-plain.rkt
(require racket/file racket/string)
(define-values (src dst) (values (vector-ref (current-command-line-arguments) 0)
                                 (vector-ref (current-command-line-arguments) 1)))
(define (rep s from to)
  (define r (string-replace s from to #:all? #f))
  (when (equal? r s) (error 'gen-amb-plain "pattern not found: ~a" from))
  r)
(define (between s from to new)
  (define i (caar (or (regexp-match-positions (regexp-quote from) s) (error 'from from))))
  (define j (caar (or (regexp-match-positions (regexp-quote to) s i) (error 'to to))))
  (string-append (substring s 0 i) new (substring s j)))

(define header #<<E
;; PLAIN-AMB VARIANT (generated by gen-amb-plain.rkt from
;; trs2-local-fused.rkt): needs only amb master.
;;
;; Goal : Substitution -> Substitution is kept.  The search combinators
;; (disj2, conj2, ifte, once, defrel) are the stream combinators of
;; trs2-impl.scm, fused: `lift` records a goal's stream function, and
;; `reify-goal` uses it directly, so the combinators never go through
;; amb and their suspensions are ordinary TRS2 thunks.
;;
;; amb runs the direct-style goals.  `==`, `succeed` and `fail` have at
;; most one answer: their streams are mature, (list s) or '(), as in
;; trs2-impl.scm; `==` still unifies in direct style (failing with amb)
;; inside an in-amb/do search.  A goal written by hand is reified
;; lazily: each answer is followed by a suspension, so asking for its
;; first answer never runs it further.  Such a goal is atomic with
;; respect to suspensions: when it calls a combinator goal in its body,
;; `reflect` FORCES that goal's suspensions instead of passing them on.
;; Scheduling inside a hand-written goal is therefore answer-level (like
;; TRS1), not pause-level: one whose combinator subgoal pauses forever
;; without an answer starves its siblings (trs2-amb-plain-limits.rkt).
;;
;; The rest of the description below is that of the fused variant.
;;

E
  )

(define protocol #<<E
;;; Local search protocol

;; A TRS2 stream; built lazily from a local search, consumed once.
(define-type Inf (Rec I (U Null (Pairof Substitution I) (→ I))))

;; Fusion: a lifted goal is not reflected and re-reified.
(: lifted (HashTable Goal (→ Substitution Inf)))
(define lifted (make-weak-hasheq))

(: reify-goal (→ Goal Substitution Inf))
(define (reify-goal g s)
  (define f (hash-ref lifted g #f))
  (if f (f s) (reify-goal/amb g s)))

;; A goal written by hand: its answers, each followed by a suspension.
(: reify-goal/amb (→ Goal Substitution Inf))
(define (reify-goal/amb g s)
  (define-values (more? get) (sequence-generate (in-amb/do (g s))))
  (let loop : Inf ()
    (if (more?) (cons (get) (λ () (loop))) '())))

;; A direct-style goal with at most one answer: a mature stream.
(: reify-goal/one (→ Goal Substitution Inf))
(define (reify-goal/one g s)
  (define-values (more? get) (sequence-generate (in-amb/do (g s))))
  (if (more?) (list (get)) '()))

;; `succeed` and `fail` as streams.
(hash-set! lifted succeed (λ ([s : Substitution]) (list s)))
(hash-set! lifted fail (λ ([s : Substitution]) '()))

;; Two-way choice point.
(: choose2 (→ Substitution (→ Substitution) Substitution))
(define (choose2 a thk)
  (define n 0)
  ((inst make-amb Substitution)
   (λ () (< n 2))
   (λ () (set! n (add1 n)) (if (= n 1) a (thk)))))

;; reflect: back to direct style.  A suspension is forced here: a
;; direct-style goal cannot pass it on without an amb extension.
(: reflect (→ Inf Substitution))
(define (reflect s-inf)
  (cond
    [(null? s-inf) (amb)]
    [(pair? s-inf) (choose2 (car s-inf) (λ () (reflect (cdr s-inf))))]
    [else (reflect (s-inf))]))


E
  )

(define out
  (let* ([s (file->string src)]
         [s (rep s ";; FUSED VARIANT of trs2-local.rkt" (string-append header ";; FUSED VARIANT of trs2-local.rkt"))]
         [s (between s ";;; Local search protocol" "(: lift (→ (→ Substitution Inf) Goal))" protocol)]
         [s (rep s "(: == (→ Term Term Goal))\n(define ((== u v) s) (unify u v s))"
                   ";; Direct style, with a mature stream for the combinators.\n(: == (→ Term Term Goal))\n(define (== u v)\n  (define g : Goal (λ (s) (unify u v s)))\n  (hash-set! lifted g (λ ([s : Substitution]) (reify-goal/one g s)))\n  g)")])
    (when (regexp-match? #rx"pause-tag|abort-current-continuation|\\(suspend\\)" s)
      (error 'gen-amb-plain "leftover pause machinery"))
    s))
(display-to-file out dst #:exists 'replace)
