#lang racket/base
;; Derive trs2-local-fused.rkt from trs2-local.rkt: lifted goals remember
;; their stream function, reify-goal short-circuits them (reify ∘ lift = id),
;; and defrel becomes TRS2's own (λ (s) (λ () ...)) lifted.
(require racket/file racket/string)
(define-values (src dst) (values (vector-ref (current-command-line-arguments) 0)
                                 (vector-ref (current-command-line-arguments) 1)))
(define s (file->string src))
(define (rep s from to)
  (define r (string-replace s from to #:all? #f))
  (when (equal? r s) (error 'gen-fused "pattern not found: ~a" from))
  r)
(define out
  (for/fold ([s s]) ([p (list
   (cons ";; RESEARCH PROTOTYPE (ambKanren issue #14)."
         ";; FUSED VARIANT of trs2-local.rkt (generated by gen-fused.rkt):\n;; reify-goal (lift f) = f, so amb runs only direct-style leaves.\n;;\n;; RESEARCH PROTOTYPE (ambKanren issue #14).")
   (cons "(: reify-goal (→ Goal Substitution Inf))\n(define (reify-goal g s)\n"
         ";; Fusion: a lifted goal is not reflected and re-reified.\n(: lifted (HashTable Goal (→ Substitution Inf)))\n(define lifted (make-weak-hasheq))\n\n(: reify-goal (→ Goal Substitution Inf))\n(define (reify-goal g s)\n  (define f (hash-ref lifted g #f))\n  (if f (f s) (reify-goal/amb g s)))\n\n(: reify-goal/amb (→ Goal Substitution Inf))\n(define (reify-goal/amb g s)\n")
   (cons "(define ((lift f) s) (reflect (f s)))"
         "(define (lift f)\n  (define g : Goal (λ (s) (reflect (f s))))\n  (hash-set! lifted g f)\n  g)")
   (cons "#'(define (name param ...) : Goal\n         (λ (s)\n           (suspend)\n           ((conj g ...) s)))"
         "#'(define (name param ...) : Goal\n         (lift (λ (s) (λ () (reify-goal (conj g ...) s)))))"))])
    (rep s (car p) (cdr p))))
(display-to-file out dst #:exists 'replace)
