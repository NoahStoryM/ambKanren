#lang typed/racket/base

;; ambKanren with the language of The Reasoned Schemer, second edition.
;;
;; The interface and the definitions of walk, unify, ifte, once, and
;; reification follow the official code of the second edition
;; (https://github.com/TheReasonedSchemer2ndEd/CodeFromTheReasonedSchemer2ndEd,
;; trs2-impl.scm), Copyright (c) 2018 Daniel P. Friedman, William E.
;; Byrd, Oleg Kiselyov, and Jason Hemann, MIT License; see NOTICE.
;;
;; Goals are Substitution -> Substitution, and backtracking is done by
;; amb instead of streams.  The suspension that the second edition
;; inserts in every relation (an immature stream) is a choice point
;; whose continuation is sent to the back of amb's frontier.

(require (for-syntax racket/base syntax/parse)
         typed/amb
         (only-in racket/list take))

(provide (all-defined-out))


;;; Terms and substitutions

(define-type Term
  (∪ Boolean Number Char Bytes String Keyword Null Symbol
     Var (Pair Term Term)))
(define-type Substitution (Immutable-HashTable Var Term))
(define-type Goal (→ Substitution Substitution))

(struct var ([name : Symbol])
  #:type-name Var
  #:transparent)

(: empty-s Substitution)
(define empty-s #hasheq())

(: walk (→ Term Substitution Term))
(define (walk v s)
  (if (and (var? v) (hash-has-key? s v))
      (walk (hash-ref s v) s)
      v))

(: occurs? (→ Var Term Substitution Boolean))
(define (occurs? x v s)
  (let ([v (walk v s)])
    (cond
      [(var? v) (eq? v x)]
      [(pair? v) (or (occurs? x (car v) s) (occurs? x (cdr v) s))]
      [else #f])))

;; Fails (with amb) instead of returning #f.
(: ext-s (→ Var Term Substitution Substitution))
(define (ext-s x v s)
  (if (occurs? x v s) (amb) (hash-set s x v)))

(: unify (→ Term Term Substitution Substitution))
(define (unify u v s)
  (let ([u (walk u s)] [v (walk v s)])
    (cond
      [(eq? u v) s]
      [(var? u) (ext-s u v s)]
      [(var? v) (ext-s v u s)]
      [(and (pair? u) (pair? v))
       (unify (cdr u) (cdr v) (unify (car u) (car v) s))]
      [(equal? u v) s]
      [else (amb)])))


;;; Goals

(: == (→ Term Term Goal))
(define ((== u v) s) (unify u v s))

(: succeed Goal)
(define (succeed s) s)

(: fail Goal)
(define (fail s) (amb))

;; GRADED VARIANT (generated by gen-graded.rkt from this file):
;; lawful levels, direct style, iterative deepening.  See gen-graded.rkt.

;; mplus: a choice between the two goals.
(: disj2 (→ Goal Goal Goal))
(define ((disj2 g1 g2) s) ((amb g1 g2) s))

;; bind: function composition.
(: conj2 (→ Goal Goal Goal))
(define ((conj2 g1 g2) s) (g2 (g1 s)))

;;; Cost (the grading)

;; The cost of a path lives in the state, under a variable no term can
;; mention, so Goal stays Substitution -> Substitution (microKanren's
;; state carries a counter too).
(define cost-var : Var (var (string->uninterned-symbol "cost")))

(: cost (→ Substitution Natural))
(define (cost s)
  (let ([c (hash-ref s cost-var (λ () 0))])
    (if (exact-nonnegative-integer? c) c 0)))

(: current-budget (Parameterof Natural))
(define current-budget (make-parameter 0))

;; Set when a path was pruned: the current level is not the last one.
(: current-cut (Parameterof (Boxof Boolean)))
(define current-cut (make-parameter ((inst box Boolean) #f)))

;; A relation call.  This replaces the book's immature stream.
(: tick (→ Substitution Substitution))
(define (tick s)
  (let ([c (add1 (cost s))])
    (cond
      [(> c (current-budget)) (set-box! (current-cut) #t) (amb)]
      [else (hash-set s cost-var c)])))

;; All answers of (g s) within the budget, depth-first, and whether some
;; path was pruned.
(: search (→ Goal Substitution (Values (Listof Substitution) Boolean)))
(define (search g s)
  (define cut : (Boxof Boolean) (box #f))
  (define answers
    (parameterize ([current-cut cut]
                   [current-amb-depth-first? #t]
                   [current-amb-fair? #f])
      (for/list : (Listof Substitution) ([s : Substitution (in-amb/do (g s))]) s)))
  (values answers (unbox cut)))

(: choose (→ (Listof Substitution) Substitution))
(define (choose l)
  ((inst make-amb Substitution)
   (λ () (pair? l))
   (λ () (begin0 (car l) (set! l (cdr l))))))

(: call/fresh (→ Symbol (→ Var Goal) Goal))
(define (call/fresh name f) (f (var name)))

(: ifte (→ Goal Goal Goal Goal))
(define ((ifte g1 g2 g3) s)
  (define-values (answers cut?) (search g1 s))
  (when cut? (set-box! (current-cut) #t))
  (cond
    [(pair? answers) (g2 (choose answers))]
    [cut? (amb)]                        ; undecided at this level
    [else (g3 s)]))

(: once (→ Goal Goal))
(define ((once g) s)
  (define-values (answers cut?) (search g s))
  (cond
    [(null? answers) (when cut? (set-box! (current-cut) #t)) (amb)]
    [else
     (for/fold ([m : Substitution (car answers)]) ([a (in-list (cdr answers))])
       (if (< (cost a) (cost m)) a m))]))


;;; Reification

(: walk* (→ Term Substitution Term))
(define (walk* v s)
  (let ([v (walk v s)])
    (cond
      [(var? v) v]
      [(pair? v) (cons (walk* (car v) s) (walk* (cdr v) s))]
      [else v])))

(: reify-name (→ Index Symbol))
(define (reify-name n)
  (string->symbol (format "_~a" n)))

(: reify-s (→ Term Substitution Substitution))
(define (reify-s v r)
  (let ([v (walk v r)])
    (cond
      [(var? v) (hash-set r v (reify-name (hash-count r)))]
      [(pair? v) (reify-s (cdr v) (reify-s (car v) r))]
      [else r])))

(: reify (→ Term (→ Substitution Term)))
(define ((reify v) s)
  (let* ([v (walk* v s)]
         [r (reify-s v empty-s)])
    (walk* v r)))

(: run-goal (→ (Option Natural) Goal (Listof Substitution)))
(define (run-goal n g)
  (let loop ([k : Natural 0] [acc : (Listof Substitution) '()])
    (define-values (answers cut?)
      (parameterize ([current-budget k]) (search g empty-s)))
    (define all
      (append acc (filter (λ ([s : Substitution]) (= (cost s) k)) answers)))
    (cond
      [(and n (>= (length all) n)) (take all n)]
      [(not cut?) all]
      [else (loop (add1 k) all)])))


;;; Syntax

(define-syntax disj
  (syntax-rules ()
    [(_) fail]
    [(_ g) g]
    [(_ g0 g ...) (disj2 g0 (disj g ...))]))

(define-syntax conj
  (syntax-rules ()
    [(_) succeed]
    [(_ g) g]
    [(_ g0 g ...) (conj2 g0 (conj g ...))]))

(define-syntax (defrel stx)
  (syntax-parse stx
    #:datum-literals (:)
    [(_ (name:id arg ...) g ...)
     #:with (param ...)
     (for/list ([arg (in-list (syntax->list #'(arg ...)))])
       (syntax-parse arg
         #:datum-literals (:)
         [x:id #'[x : Term]]
         [[x:id : t] arg]))
     #'(define (name param ...) : Goal
         (λ (s)
           ((conj g ...) (tick s))))]))

(define-syntax run
  (syntax-rules ()
    [(_ n (x0 x ...) g ...)
     (run n q (fresh (x0 x ...)
                (== (list x0 x ...) q)
                g ...))]
    [(_ n q g ...)
     (let ([q (var 'q)])
       (map (reify q) (run-goal n (conj g ...))))]))

(define-syntax-rule (run* q g ...) (run #f q g ...))

(define-syntax fresh
  (syntax-rules ()
    [(_ () g ...) (conj g ...)]
    [(_ (x0 x ...) g ...)
     (call/fresh 'x0
                 (λ ([x0 : Var])
                   (fresh (x ...) g ...)))]))

(define-syntax-rule (conde [g ...] ...)
  (disj (conj g ...) ...))

(define-syntax conda
  (syntax-rules ()
    [(_ [g0 g ...]) (conj g0 g ...)]
    [(_ [g0 g ...] ln ...)
     (ifte g0 (conj g ...) (conda ln ...))]))

(define-syntax-rule (condu [g0 g ...] ...)
  (conda [(once g0) g ...] ...))

(define-syntax-rule (project (x ...) g ...)
  (λ ([s : Substitution])
    (let ([x (walk* x s)] ...)
      ((conj g ...) s))))
