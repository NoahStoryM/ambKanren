#lang racket/base
;; Derive trs2-shift.rkt from trs2-exn.rkt: no in-amb/do trampoline.
;; reify / reflect are Filinski's, written with one prompt tag and
;; composable continuations (shift / reset), for the TRS2 stream monad
;; itself, so a local search yields the book's Inf directly.
;;   reify   = reset            (g s) runs under a prompt, result (list s)
;;   reflect = shift k (append-map-inf k s-inf)
;;   defrel  = reflect (λ () (reify body s))   the book's delay, D(m) = τ::m
;; conj2 is plain composition: the continuation captured by reflect is
;; "the rest of the conjunction", so append-map-inf k is conj2 itself.
;; Composition forgets how conjunctions are grouped, so every syntactic
;; conj reifies its body (see the conj macro); a relation body is also the
;; book's delay D.
;; amb is not used at all.
;; Usage: racket gen-shift.rkt trs2-exn.rkt trs2-shift.rkt
(require racket/file racket/string)
(define-values (src dst) (values (vector-ref (current-command-line-arguments) 0)
                                 (vector-ref (current-command-line-arguments) 1)))
(define (rep s from to)
  (define r (string-replace s from to #:all? #f))
  (when (equal? r s) (error 'gen-shift "pattern not found: ~a" from))
  r)
(define (between s start end new)
  (define i (car (regexp-match-positions (regexp-quote start) s)))
  (define j (car (regexp-match-positions (regexp-quote end) s (cdr i))))
  (string-append (substring s 0 (car i)) new (substring s (car j))))

(define local-search #<<END
;;; Local search: reify / reflect by delimited control

;; A TRS2 stream.
(define-type Inf (Rec I (U Null (Pairof Substitution I) (→ I))))

;; The only control effect.  An abort carries the body of a shift, to be
;; run in place of the whole delimited computation.
(: tag (Prompt-Tagof Inf (→ (→ Inf) Inf)))
(define tag (make-continuation-prompt-tag 'kanren))

(: reset (→ (→ Inf) Inf))
(define (reset thk)
  (call-with-continuation-prompt thk tag (λ ([body : (→ Inf)]) (reset body))))

;; shift: k is the rest of the goal up to the nearest reify, wrapped in
;; its own reset as usual.
(: shift (→ (→ (→ Substitution Inf) Inf) Substitution))
(define (shift f)
  ((inst call-with-composable-continuation Inf (→ (→ Inf) Inf) Substitution)
   (λ (k)
     (abort-current-continuation
      tag
      (λ () (f (λ ([s : Substitution]) (reset (λ () (k s))))))))
   tag))

;; reify: (g s) as the book's stream.  No sequence, no trampoline: a goal
;; that returns normally has produced exactly one answer.
(: reify-goal (→ Goal Substitution Inf))
(define (reify-goal g s)
  (reset (λ () (list (g s)))))

;; reflect: a stream back into direct style.  The continuation is the
;; rest of the conjunction, so this IS append-map-inf of the book.
(: reflect (→ Inf Substitution))
(define (reflect s-inf)
  (shift (λ (k) (append-map-inf k s-inf))))

(: lift (→ (→ Substitution Inf) Goal))
(define ((lift f) s) (reflect (f s)))

(: append-inf (→ Inf Inf Inf))
(define (append-inf s-inf t-inf)
  (cond
    [(null? s-inf) t-inf]
    [(pair? s-inf) (cons (car s-inf) (append-inf (cdr s-inf) t-inf))]
    [else (λ () (append-inf t-inf (s-inf)))]))

(: append-map-inf (→ (→ Substitution Inf) Inf Inf))
(define (append-map-inf g s-inf)
  (cond
    [(null? s-inf) '()]
    [(pair? s-inf) (append-inf (g (car s-inf)) (append-map-inf g (cdr s-inf)))]
    [else (λ () (append-map-inf g (s-inf)))]))

(: take-inf (→ (Option Natural) Inf (Listof Substitution)))
(define (take-inf n s-inf)
  (cond
    [(and n (zero? n)) '()]
    [(null? s-inf) '()]
    [(pair? s-inf) (cons (car s-inf) (take-inf (and n (sub1 n)) (cdr s-inf)))]
    [else (take-inf n (s-inf))]))

;; Only disj2 delimits: each branch is its own reify.
(: disj2 (→ Goal Goal Goal))
(define (disj2 g1 g2)
  (lift (λ (s) (append-inf (reify-goal g1 s) (reify-goal g2 s)))))

;; Plain composition: whatever g1 reflects, its continuation runs g2.
(: conj2 (→ Goal Goal Goal))
(define ((conj2 g1 g2) s)
  (g2 (g1 s)))

(: call/fresh (→ Symbol (→ Var Goal) Goal))
(define (call/fresh name f) (f (var name)))

;; ifte and once inspect g1's stream, so they stay lifted, as in the book.
(: ifte (→ Goal Goal Goal Goal))
(define (ifte g1 g2 g3)
  (lift
   (λ (s)
     (let loop : Inf ([s-inf (reify-goal g1 s)])
       (cond
         [(null? s-inf) (reify-goal g3 s)]
         [(pair? s-inf)
          (append-map-inf (λ ([s : Substitution]) (reify-goal g2 s)) s-inf)]
         [else (λ () (loop (s-inf)))])))))

(: once (→ Goal Goal))
(define (once g)
  (lift
   (λ (s)
     (let loop : Inf ([s-inf (reify-goal g s)])
       (cond
         [(null? s-inf) '()]
         [(pair? s-inf) (list (car s-inf))]
         [else (λ () (loop (s-inf)))])))))


END
  )

(define out
  (for/fold ([s (between (file->string src) ";;; Local search protocol" ";;; Reification" local-search)])
            ([p (list
   (cons ";; EXCEPTION VARIANT (generated by gen-exn.rkt from trs2-local.rkt):\n;; amb for choice, Racket's raise / with-handlers for the pause, the\n;; handler installed inside every local search.  amb master only.\n"
         ";; SHIFT/RESET VARIANT (generated by gen-shift.rkt from trs2-exn.rkt):\n;; no in-amb/do.  reify / reflect are written directly with one prompt\n;; tag and composable continuations, so a local search produces the\n;; book's stream with no intermediate sequence.  amb is not used.\n;; (The rest of this header describes trs2-exn.rkt.)\n")
   (cons "(require (for-syntax racket/base syntax/parse)\n         typed/amb)"
         "(require (for-syntax racket/base syntax/parse))")
   (cons "(define (fail s) (amb))" "(define (fail s) (reflect '()))")
   (cons ";; Fails (with amb) instead of returning #f." ";; Fails (reflects the empty stream) instead of returning #f.")
   (cons "(if (occurs? x v s) (amb) (hash-set s x v))" "(if (occurs? x v s) (reflect '()) (hash-set s x v))")
   (cons "      [else (amb)])))" "      [else (reflect '())])))")
   (cons "  (parameterize ([current-amb-depth-first? #t] [current-amb-fair? #f])\n    (take-inf n (reify-goal g empty-s))))"
         "  (take-inf n (reify-goal g empty-s)))")
   (cons "(define-syntax conj\n  (syntax-rules ()\n    [(_) succeed]\n    [(_ g) g]\n    [(_ g0 g ...) (conj2 g0 (conj g ...))]))"
         ";; Every syntactic conj delimits its body: inside one conj the goals are\n;; composed flat, which is the book's right nesting; a conj nested as the\n;; left argument of another (directly, or as a fresh body or a relation\n;; body) keeps its own group.  Calling conj2 by hand bypasses this.\n(define-syntax conj\n  (syntax-rules ()\n    [(_) succeed]\n    [(_ g) g]\n    [(_ g0 g ...) (lift (λ (s) (reify-goal (conj* g0 g ...) s)))]))\n\n(define-syntax conj*\n  (syntax-rules ()\n    [(_ g) g]\n    [(_ g0 g ...) (conj2 g0 (conj* g ...))]))")
   (cons "         (λ (s)\n           (suspend)\n           ((conj g ...) s)))]))"
         "         (λ (s)\n           (reflect (λ () (reify-goal (conj g ...) s)))))]))"))])
    (rep s (car p) (cdr p))))
(display-to-file out dst #:exists 'replace)
