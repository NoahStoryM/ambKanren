#lang racket/base
;; Derive trs2-amb-handler.rkt from trs2-local-fused.rkt (amb branch
;; research/amb-handler-20261110): (amb) is answered by the handler of
;; the innermost search.  The suspension is (when (amb #t #f) (amb)), the
;; local search is (in-amb/do (g s) #:empty (λ () PAUSED)), and every
;; failure is (amb-fail), which no handler answers.
;; Usage: racket gen-amb-handler.rkt trs2-local-fused.rkt trs2-amb-handler.rkt
;;        racket gen-amb-handler.rkt trs2-local.rkt trs2-amb-handler-unfused.rkt
;;        (unfused: every suspension really goes through the handler)
(require racket/file racket/string)
(define-values (src dst) (values (vector-ref (current-command-line-arguments) 0)
                                 (vector-ref (current-command-line-arguments) 1)))
(define (rep s from to)
  (define r (string-replace s from to #:all? #f))
  (when (equal? r s) (error 'gen-amb-handler "pattern not found: ~a" from))
  r)
(define header
  ";; AMB-HANDLER VARIANT (generated by gen-amb-handler.rkt): (amb) is\n;; answered by the #:empty handler of the innermost search.  The\n;; suspension is (when (amb #t #f) (amb)), each local search gives the\n;; handler (λ () PAUSED), and failure is (amb-fail).  A plain in-amb/do\n;; (default handler amb-fail) only reschedules on a suspension.\n;;\n")
(define src-text (file->string src))
(define anchor
  (if (regexp-match? #rx";; FUSED VARIANT of trs2-local.rkt" src-text)
      ";; FUSED VARIANT of trs2-local.rkt"
      ";; RESEARCH PROTOTYPE (ambKanren issue #14)."))
(define out
  (for/fold ([s (string-replace src-text "(amb)" "(amb-fail)")])
            ([p (list
   (cons anchor (string-append header anchor))
   (cons "(: pause-tag (Prompt-Tagof (U Substitution Symbol) (→ Symbol)))\n(define pause-tag (make-continuation-prompt-tag 'kanren-pause))\n(define PAUSE : Symbol (string->uninterned-symbol \"PAUSE\"))\n"
         ";; What a suspension outputs; ambKanren's own, not amb's.\n(struct paused ())\n(define PAUSED (paused))\n")
   (cons "(define (suspend)\n  (when (amb #t #f)\n    (abort-current-continuation pause-tag)))"
         "(define (suspend)\n  (when (amb #t #f)\n    (amb)))")
   (cons "     (in-amb/do\n      (call-with-continuation-prompt\n       (λ () : (U Substitution Symbol) (g s))\n       pause-tag\n       (λ () PAUSE)))))"
         "     (in-amb/do (g s) #:empty (λ () PAUSED))))")
   (cons "(if (symbol? v) (λ () (loop)) (cons v (loop)))"
         "(if (paused? v) (λ () (loop)) (cons v (loop)))"))])
    (rep s (car p) (cdr p))))
(display-to-file out dst #:exists 'replace)
